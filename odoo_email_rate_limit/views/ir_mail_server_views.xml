<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ir_mail_server_form_rate_limit" model="ir.ui.view">
        <field name="name">ir.mail.server.form.rate.limit</field>
        <field name="model">ir.mail_server</field>
        <field name="inherit_id" ref="base.view_ir_mail_server_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sequence']" position="after">
                <separator string="Email Rate Limit"/>
                <field name="rate_limit_enabled"/>
                <field name="rate_limit_count" invisible="not rate_limit_enabled"/>
                <field name="rate_limit_window" invisible="not rate_limit_enabled"/>
                <field name="fallback_enabled"/>
                <field name="fallback_server_id" invisible="not fallback_enabled"/>
                <field name="rate_limit_retry_delay" invisible="not fallback_enabled"/>
                <field name="rate_limit_max_retries" invisible="not fallback_enabled"/>
            </xpath>
        </field>
    </record>
</odoo>
