<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_email_sender_pool" model="ir.ui.view">
        <field name="name">res.config.settings.email.sender.pool</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Customer Email Sender Pools" name="odoo_email_rate_limit" data-key="odoo_email_rate_limit">
                    <block title="Signup Sender Pool">
                        <setting string="Signup 1" help="First new signup customer in the round-robin pool.">
                            <field name="signup1_email" placeholder="signup1@example.com"/>
                            <field name="signup1_mail_server_id" options="{'no_create': True}"/>
                        </setting>
                        <setting string="Signup 2" help="Second new signup customer in the round-robin pool.">
                            <field name="signup2_email" placeholder="signup2@example.com"/>
                            <field name="signup2_mail_server_id" options="{'no_create': True}"/>
                        </setting>
                    </block>
                    <block title="Existing Customer / Order Sender Pool">
                        <setting string="Order 1" help="First existing customer entering the purchase pool.">
                            <field name="order1_email" placeholder="order1@example.com"/>
                            <field name="order1_mail_server_id" options="{'no_create': True}"/>
                        </setting>
                        <setting string="Order 2" help="Second existing customer entering the purchase pool.">
                            <field name="order2_email" placeholder="order2@example.com"/>
                            <field name="order2_mail_server_id" options="{'no_create': True}"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
