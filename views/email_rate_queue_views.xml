<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_email_rate_queue_list" model="ir.ui.view">
        <field name="name">email.rate.queue.list</field>
        <field name="model">email.rate.queue</field>
        <field name="arch" type="xml">
            <list>
                <field name="priority" widget="priority"/>
                <field name="mail_id"/>
                <field name="mail_server_id"/>
                <field name="state"/>
                <field name="scheduled_at"/>
                <field name="retry_count"/>
                <field name="fallback_used"/>
                <field name="error_message" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_email_rate_queue_form" model="ir.ui.view">
        <field name="name">email.rate.queue.form</field>
        <field name="model">email.rate.queue</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="mail_id"/>
                        <field name="mail_server_id"/>
                        <field name="priority"/>
                        <field name="state"/>
                        <field name="scheduled_at"/>
                        <field name="retry_count"/>
                        <field name="fallback_used"/>
                    </group>
                    <field name="error_message"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_email_rate_queue" model="ir.actions.act_window">
        <field name="name">Instant Email Queue</field>
        <field name="res_model">email.rate.queue</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_email_rate_queue" name="Instant Email Queue"
              parent="mail.menu_email" action="action_email_rate_queue"
              sequence="90" groups="base.group_no_one"/>
</odoo>
